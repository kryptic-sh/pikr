# Auto-generated. Source: https://github.com/kryptic-sh/pikr
# Edits made directly to a built .deb / .rpm are not tracked. To change
# this manifest, edit `pkg/nfpm/nfpm.yaml.in` in the upstream repo and
# let `.github/workflows/ci.yml` rebuild on the next tag.
#
# `arch` is nfpm's normalized form (amd64 / arm64); the tool translates
# to the per-format native name (amd64 → x86_64 on rpm, arm64 → aarch64).
name: pikr
arch: {ARCH}
platform: linux
version: {VERSION}
section: x11
priority: optional
maintainer: mxaddict <mxaddict@kryptic.sh>
description: |
  Vim-modal application launcher — rofi replacement.
  Modal editing (Insert / Normal / Visual), fuzzy matching with
  frecency scoring, per-mode query history, and Wayland layer-shell
  support.
vendor: kryptic-sh
homepage: https://pikr.kryptic.sh/
license: MIT

# Binary layout. The tarball produced by the build matrix contains a
# top-level `pikr` executable plus LICENSE / README; the CI job extracts
# them into the workdir before invoking nfpm so these paths are relative.
contents:
  - src: ./pikr
    dst: /usr/bin/pikr
    file_info:
      mode: 0755
  - src: ./LICENSE
    dst: /usr/share/licenses/pikr/LICENSE
    file_info:
      mode: 0644
  - src: ./README.md
    dst: /usr/share/doc/pikr/README.md
    file_info:
      mode: 0644

# Format-specific runtime dependencies. crcbl loads every one of these with
# dlopen, so the binary's ELF names none of them and this list is the only
# place they are declared:
# - libwayland-client and libxkbcommon for the Wayland window and keymaps
# - the Vulkan loader for rendering, and a Vulkan driver for it to load
# - fontconfig for font lookup
# - libxcb and libxkbcommon-x11 for the X11 fallback; RandR, XInput, XKB and
#   SHAPE are optional extensions there (one monitor, no raw motion, no
#   detectable auto-repeat, and the panel's see-through corners taking clicks
#   without them)
overrides:
  deb:
    depends:
      - libxkbcommon0
      - libwayland-client0
      - libvulkan1
      - libfontconfig1
    recommends:
      - mesa-vulkan-drivers
      - libxcb1
      - libxkbcommon-x11-0
      - libxcb-randr0
      - libxcb-xinput0
      - libxcb-xkb1
      - libxcb-shape0
  rpm:
    depends:
      - libxkbcommon
      - libwayland-client
      - vulkan-loader
      - fontconfig
    recommends:
      - mesa-vulkan-drivers
      - libxcb
      - libxkbcommon-x11
